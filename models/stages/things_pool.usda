#usda 1.0
# Stable V3 five-object pool; source geometry, materials and textures stay referenced.
# Apple/lunchbag child bodies are promoted to the root with transformed mass
# frames. Their captured geometry transforms and inertias remain unchanged.
# Same contact material, collider margins and remote cradles as fruit_pool.
# All bodies exist before PhysX starts; resets change live poses/velocities only.
(
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "Task"
    {
        def Xform "Things"
        {
            def Material "ThingContact" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.5
                float physics:restitution = 0
                float physics:staticFriction = 0.6
                token physxMaterial:frictionCombineMode = "average"
                token physxMaterial:restitutionCombineMode = "average"
            }

            def Xform "apple_02" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI", "MaterialBindingAPI"]
                prepend references = @../addons/objects/objaverse/apple_02.usd@
            )
            {
                rel material:binding:physics = </World/Task/Things/ThingContact> (
                    bindMaterialAs = "strongerThanDescendants"
                )
                vector3f physics:angularVelocity = (0, 0, 0)
                point3f physics:centerOfMass = (-0.0002396542, 0.00036137988, -0.017344648)
