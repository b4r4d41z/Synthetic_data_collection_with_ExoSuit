#usda 1.0
# Ambidextrous-only persistent four-object pool. Individual source assets remain unchanged.
# Existing body promotion, mass/inertia, collider margins and contact profile are preserved.
# Static cradles copied from the validated fruit pool; no other pool is referenced.
(
    metersPerUnit = 1
    upAxis = "Z"
)

