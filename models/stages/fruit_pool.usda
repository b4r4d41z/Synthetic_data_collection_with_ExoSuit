                uniform token[] xformOpOrder = ["xformOp:transform:bfmEpisode"]

                over "orange_02_inst"
                {
                    over "Orange_02"
                    {
                        over "OrangeSkin" (
                            prepend apiSchemas = ["PhysxCollisionAPI"]
                        )
                        {
                            float physxCollision:contactOffset = 0.002
                            float physxCollision:restOffset = 0
                            rel material:binding:physics = </World/Task/Fruits/FruitContact>
                        }
                        over "OrangeStem" (
                            prepend apiSchemas = ["PhysxCollisionAPI"]
                        )
                        {
                            float physxCollision:contactOffset = 0.002
                            float physxCollision:restOffset = 0
                            rel material:binding:physics = </World/Task/Fruits/FruitContact>
                        }
                    }
                }
            }
        }

