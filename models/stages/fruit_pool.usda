#usda 1.0
# Stable fruit bodies and static parking cradles, loaded before PhysX.
# Parking is far outside the task workspace and above the ground plane.
# Episode resets override transforms/velocities only.
(
    metersPerUnit = 1
    upAxis = "Z"
)

