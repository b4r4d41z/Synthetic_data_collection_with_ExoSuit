    def Xform "palm000_collision" (
        prepend references = @./geometries.usd@</Geometries/palm000_collision>
    )
    {
        over "palm000_collision" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
        )
        {
            custom rel material:binding:physics
            prepend rel material:binding:physics = </biped_s40_with_sharpa_wave_hands/Physics/PhysicsMaterial_1>
            int mjc:group = 3
            double[] mjc:solref = [0.01, 1]
            float newton:contactGap = 0 (
                limits = {
                    dictionary hard = {
                        double minimum = 0
                    }
                }
            )
            token physics:approximation = "convexHull"
            float physics:density = 1000
            token purpose = "guide"
        }
    }

