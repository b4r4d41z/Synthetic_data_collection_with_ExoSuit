#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "silver"
    {
        color3f inputs:diffuseColor = (0.5870164, 0.63828325, 0.8480884)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/silver/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/silver/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/silver.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/silver.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/silver.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/silver.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "green"
    {
        color3f inputs:diffuseColor = (0.033104762, 1, 0.033104762)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/green/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/green/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/green.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/green.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/green.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/green.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "collision"
    {
        color3f inputs:diffuseColor = (0.010022826, 0.21404114, 0.78741235)
        float inputs:metallic = 0
        float inputs:opacity = 0
        float inputs:roughness = 0.5
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/collision/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/collision/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/collision.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/collision.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/collision.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/collision.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

