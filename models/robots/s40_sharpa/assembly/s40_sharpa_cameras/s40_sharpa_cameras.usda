#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "biped_s40_with_sharpa_wave_hands"
    kilogramsPerUnit = 1
    metersPerUnit = 1
