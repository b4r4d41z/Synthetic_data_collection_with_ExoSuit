
# ROS2 / colcon build artifacts
exo2isaacsim/build/
exo2isaacsim/install/
exo2isaacsim/log/
# Python cache
__pycache__/
*.py[cod]
*$py.class
# Python package metadata
*.egg-info/
.eggs/
dist/
build/
# Virtual environments
.venv/
venv/
env/
# IDE files
.vscode/
.idea/
# OS files
.DS_Store
Thumbs.db
# Temporary files
*.tmp
*.log
# Local bridge configuration
docker/exo_ros_bridge/.env
# Docker temporary files
docker/exo_ros_bridge/**/__pycache__/
# Legacy models
/models/legacy/
/camera.patch

# Simulation bag recordings
/records/

# Historical host-side launcher (current deployment uses Docker bridges)
start_isaac_bridge.sh

# RoboLab objects: ignore everything by default
models/addons/objects/*

# --- orange1 ---
!models/addons/objects/fruits_veggies/
models/addons/objects/fruits_veggies/*

!models/addons/objects/fruits_veggies/orange1.usd

# Shared material definitions required by orange1
!models/addons/objects/fruits_veggies/materials/
!models/addons/objects/fruits_veggies/materials/**

# Only orange1 textures
!models/addons/objects/fruits_veggies/textures/
models/addons/objects/fruits_veggies/textures/*
!models/addons/objects/fruits_veggies/textures/orange_01/
!models/addons/objects/fruits_veggies/textures/orange_01/**

# --- container_b04 ---
!models/addons/objects/vomp/
models/addons/objects/vomp/*
!models/addons/objects/vomp/container_b04/
!models/addons/objects/vomp/container_b04/**
